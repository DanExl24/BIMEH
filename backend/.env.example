# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bimeh
DB_USER=postgres
DB_PASSWORD=postgres
# DB_SSLMODE=require  # Activar en producción si el proveedor de PostgreSQL lo requiere

# CORS: Orígenes permitidos (separados por coma)
ALLOW_ORIGINS=http://localhost:5173,http://localhost:80,https://bimeh.adsoproject.dev,https://api-bimeh.adsoproject.dev

# -------------------------------------------------------------------
# Motor de IA: "gemini" (recomendado) o "ollama" (local)
# -------------------------------------------------------------------
AI_BACKEND=gemini

# Google Gemini (obtener key en: https://aistudio.google.com)
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (solo si AI_BACKEND=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
